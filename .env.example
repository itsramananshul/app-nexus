# API keys are entered IN THE NEXUS UI (🔑 button in the top bar) and stored
# in Supabase (active_client_keys table) so every browser opening Nexus
# auto-loads them on first paint. Generate each app's key in its own 🔑
# panel, then paste it into the matching row in Nexus's panel.

# Supabase — backs the active_client_keys table that holds per-node API keys.
# Use the same project that backs the 6 backend apps.
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt
